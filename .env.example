# ──────────────────────────────────────────────────────
# Kanalla Sky Bar — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────

# Supabase Project — https://app.supabase.com/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# Service Role key — ONLY used in Edge Functions / server-side, NEVER in the browser
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

# ──────────────────────────────────────────────────────
# Angular Build-time variables
# These must be injected via angular.json "fileReplacements"
# or via your CI/CD pipeline (e.g. Vercel Environment Variables).
# ──────────────────────────────────────────────────────
NG_APP_SUPABASE_URL=${SUPABASE_URL}
NG_APP_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NG_APP_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
