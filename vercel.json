{
  "buildCommand": "cd frontend && npm install && node set-env.mjs && npm run build",
  "outputDirectory": "frontend/dist/kanalla/browser",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kanallaskybar.es" }],
      "destination": "https://kanallaskybar.es/:path*",
      "permanent": true
    },
    { "source": "/menu", "destination": "/#carta", "permanent": true }
  ],
  "rewrites": [
    { "source": "/reservas", "destination": "/reservas/index.html" },
    { "source": "/((?!.*\\.).*)", "destination": "/index.csr.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.js|.*\\.css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/((?!.*\\.).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(index\\.html|index\\.csr\\.html|reservas/index\\.html)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
